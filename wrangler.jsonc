{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pasanaku-fun-docs",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
